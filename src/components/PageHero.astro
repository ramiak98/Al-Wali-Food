---
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/photos';
interface Props { photo: PhotoKey; eyebrow?: string; title: string; subtitle?: string; tall?: boolean }
const { photo, eyebrow, title, subtitle, tall = false } = Astro.props;
---
<section class={`relative isolate overflow-hidden bg-cedar-dark ${tall ? 'min-h-[440px] md:min-h-[520px]' : 'min-h-[320px] md:min-h-[400px]'} flex items-end`}>
  <Photo name={photo} eager class="absolute inset-0 w-full h-full -z-10" />
  <div class="absolute inset-0 shade-bottom -z-10"></div>
  <div class="wrap py-12 md:py-16 text-white fade-up">
    {eyebrow && <p class="eyebrow !text-[#f0dca8] mb-3">{eyebrow}</p>}
    <h1 class="text-[2.5rem] md:text-[4rem] max-w-3xl">{title}</h1>
    {subtitle && <p class="mt-3 text-lg md:text-xl max-w-2xl text-white/90">{subtitle}</p>}
    <slot />
  </div>
</section>
