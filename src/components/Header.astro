---
import Photo from './Photo.astro';
import { categories } from '../data/catalog';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About Us' },
  { href: '/products/', label: 'Products', mega: true },
  { href: '/where-to-buy/', label: 'Where to Buy' },
  { href: '/distributors/', label: 'Distributors' },
  { href: '/contact/', label: 'Contact Us' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-[#e6dccb]" style="top: env(safe-area-inset-top, 0px)">
  <div class="wrap flex items-center gap-6 h-[72px] md:h-[84px]">
    <a href="/" class="shrink-0" aria-label="Al Wali Food home">
      <img src="/brand/logo-en.png" alt="Al Wali" width="480" height="236" class="h-[50px] md:h-[60px] w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-1 ml-auto" aria-label="Main">
      {nav.map((item) =>
        item.mega ? (
          <div class="relative group">
            <a href={item.href} class={`flex items-center gap-1 px-3 py-2 rounded-[6px] text-[0.95rem] font-medium hover:text-cedar ${isActive(item.href) ? 'text-cedar' : 'text-ink'}`} aria-haspopup="true">
              {item.label}
              <svg class="w-3.5 h-3.5 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" /></svg>
            </a>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[880px]">
              <div class="bg-cream border border-[#e6dccb] rounded-[6px] shadow-[0_18px_40px_-20px_rgba(43,36,32,.35)] p-5 grid grid-cols-5 gap-4">
                {categories.map((c) => (
                  <div class="flex flex-col gap-2 min-w-0">
                    <a href={`/products/${c.slug}/`} class="block group/tile">
                      <div class="aspect-[4/3] overflow-hidden rounded-[4px] bg-sand"><Photo name={c.photo} width={400} class="w-full h-full group-hover/tile:scale-105 transition-transform duration-500" /></div>
                      <p class="mt-2 font-display text-[1.2rem] font-semibold leading-tight text-cedar">{c.name}</p>
                    </a>
                    <ul class="text-[0.8rem] text-stone leading-snug space-y-1">
                      {c.subcategories.map((s) => <li><a class="hover:text-cedar" href={`/products/${c.slug}/#${s.slug}`}>{s.name}</a></li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class={`px-3 py-2 rounded-[6px] text-[0.95rem] font-medium hover:text-cedar ${isActive(item.href) ? 'text-cedar' : 'text-ink'}`} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      )}
    </nav>

    <a href="/where-to-buy/" class="btn btn-sumac ml-auto lg:ml-2 !min-h-[42px] !px-3.5 sm:!px-4 text-[0.85rem] whitespace-nowrap">Find a Store</a>
    <button type="button" class="lg:hidden -mr-2 p-2 text-cedar" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden fixed inset-0 z-50 bg-cedar text-white overflow-y-auto" hidden>
    <div class="wrap flex items-center justify-between h-[72px]">
      <img src="/brand/logo-en.png" alt="Al Wali" width="480" height="236" class="h-[48px] w-auto" />
      <button type="button" class="-mr-2 p-2" aria-label="Close menu" data-menu-close>
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <nav class="wrap pt-4 pb-10 flex flex-col" aria-label="Mobile">
      {nav.map((item) => (
        <>
          <a href={item.href} class="font-display text-[2rem] font-semibold py-2 border-b border-white/15">{item.label}</a>
          {item.mega && (
            <ul class="grid grid-cols-2 gap-x-4 gap-y-1 py-3 border-b border-white/15">
              {categories.map((c) => <li><a href={`/products/${c.slug}/`} class="text-white/85 text-[0.95rem]">{c.name}</a></li>)}
            </ul>
          )}
        </>
      ))}
      <a href="/where-to-buy/" class="btn btn-sumac mt-8">Find a Store</a>
    </nav>
  </div>
</header>
