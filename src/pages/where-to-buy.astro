---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CategoryChecks from '../components/CategoryChecks.astro';
---
<Base title="Where to Buy Al Wali Food" fullTitle description="Ask Al Wali Food where to buy our products near you.">
  <PageHero photo="souk" eyebrow="Where to buy" title="Where to find Al Wali Food" subtitle="Our products are sold at Middle Eastern, Mediterranean and international grocery stores across the US. Ask us and we'll point you to the closest one." />

  <section class="bg-sand">
    <div class="wrap py-14 md:py-20 grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="eyebrow">Ask us where to buy</p>
        <h2 class="text-[2.2rem] md:text-[2.8rem] mt-2">Tell us where you shop</h2>
        <p class="text-stone mt-3">Send us your ZIP code and we'll point you to the closest store, or ask your favorite store to carry Al Wali Food.</p>
      </div>
      <form class="grid gap-4 sm:grid-cols-2 bg-cream rounded-[6px] p-6 md:p-8" data-demo-form data-success="We received your message and will get back to you within 2 business days with the closest place to find Al Wali Food.">
        <div class="field"><label for="wtb-name">Name <span class="req">*</span></label><input id="wtb-name" required autocomplete="name" /></div>
        <div class="field"><label for="wtb-email">Email <span class="req">*</span></label><input id="wtb-email" type="email" required autocomplete="email" /></div>
        <div class="field"><label for="wtb-zip">ZIP code <span class="req">*</span></label><input id="wtb-zip" required inputmode="numeric" pattern="[0-9]{5}" title="5-digit ZIP code" autocomplete="postal-code" /></div>
        <div class="field"><label for="wtb-store">Your favorite store (name &amp; city)</label><input id="wtb-store" /></div>
        <div class="sm:col-span-2"><CategoryChecks name="wtb-products" legend="Which products are you looking for?" notSure /></div>
        <div class="field sm:col-span-2"><label for="wtb-msg">Message</label><textarea id="wtb-msg"></textarea></div>
        <label class="sm:col-span-2 flex gap-3 items-start text-[0.92rem]"><input id="wtb-news" type="checkbox" class="mt-1 w-5 h-5 accent-[#1F4D3A]" /> Send me occasional news and recipes from Al Wali Food</label>
        <div class="sm:col-span-2 flex flex-col sm:flex-row sm:items-center gap-3">
          <button class="btn btn-sumac">Send</button>
          <p class="text-xs text-stone">Protected by Cloudflare Turnstile. See our <a class="link" href="/legal/privacy/">Privacy Policy</a>.</p>
        </div>
      </form>
    </div>
  </section>

</Base>
