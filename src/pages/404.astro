---
import Base from '../layouts/Base.astro';
import CedarMark from '../components/CedarMark.astro';
---
<Base title="Page not found">
  <section class="wrap py-24 md:py-32 text-center flex flex-col items-center">
    <CedarMark class="w-12 h-12 text-gold" />
    <h1 class="text-[2.8rem] md:text-[4rem] mt-4">This page went to the souk</h1>
    <p class="text-stone mt-3 max-w-lg">We couldn't find what you were looking for. Let's get you back to the table.</p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/" class="btn btn-cedar">Go to homepage</a>
      <a href="/products/" class="btn btn-ghost">Browse products</a>
    </div>
  </section>
</Base>
