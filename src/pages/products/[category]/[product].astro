---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Photo from '../../../components/Photo.astro';
import { categories, productImage, type Category, type Product } from '../../../data/catalog';

export function getStaticPaths() {
  return categories.flatMap((c) =>
    c.products.map((p) => ({ params: { category: c.slug, product: p.slug }, props: { cat: c, product: p } }))
  );
}
const { cat, product: p } = Astro.props as { cat: Category; product: Product };
const sub = cat.subcategories.find((s) => s.slug === p.subcategory);
const related = cat.products.filter((x) => x.slug !== p.slug).slice(0, 4);
const trade = [
  ['UPC', p.trade.upc || '[To confirm]'],
  ['Case pack', p.trade.casePack || '[To confirm, e.g. 12 × ' + p.sizes[0] + ']'],
  ['Shelf life', p.trade.shelfLife || '[To confirm]'],
  ['Country of origin', 'Lebanon'],
];
---
<Base title={`${p.name}`} description={`${p.name} (${p.nameAr}) by Al Wali Food. ${p.description}`}>
  <nav class="wrap pt-6 text-sm text-stone flex flex-wrap gap-x-2" aria-label="Breadcrumb">
    <a class="hover:text-cedar" href="/products/">Products</a> <span aria-hidden="true">›</span>
    <a class="hover:text-cedar" href={`/products/${cat.slug}/`}>{cat.name}</a> <span aria-hidden="true">›</span>
    <span class="text-ink">{p.name}</span>
  </nav>

  <section class="wrap py-8 md:py-12 grid gap-10 md:grid-cols-2">
    <div class="flex flex-col gap-3">
      <div class="aspect-square rounded-[6px] overflow-hidden bg-[#f3ece0] border border-[#e6dccb]">
        <img id="main-shot" src={productImage(p)} alt={`${p.name} placeholder packaging`} class="w-full h-full object-cover" />
      </div>
      <div class="grid grid-cols-3 gap-3">
        <button type="button" class="aspect-square rounded-[6px] overflow-hidden border-2 border-cedar bg-[#f3ece0]" data-shot={productImage(p)} aria-label="Front of pack"><img src={productImage(p)} alt="" class="w-full h-full object-cover" /></button>
        <div class="aspect-square rounded-[6px] border border-dashed border-[#cbbfa8] grid place-items-center text-center text-xs text-stone p-2">Back of pack photo to come</div>
        <div class="aspect-square rounded-[6px] overflow-hidden"><Photo name={cat.photo} width={500} class="w-full h-full" alt={`${cat.name} serving idea`} /></div>
      </div>
    </div>

    <div class="min-w-0">
      <p class="eyebrow">{cat.name}{sub ? ` · ${sub.name}` : ''}</p>
      <h1 class="text-[2.6rem] md:text-[3.4rem] mt-2 leading-[1.05]">{p.name}</h1>
      <p class="font-arabic text-gold-text text-2xl mt-1" lang="ar" dir="rtl">{p.nameAr}</p>
      <p class="mt-5 text-[1.1rem] text-stone">{p.description}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        {p.sizes.map((s) => <span class="px-3 py-1.5 rounded-full bg-sand text-sm font-medium">{s}</span>)}
        <span class="px-3 py-1.5 rounded-full border border-cedar text-cedar text-sm font-medium">Product of Lebanon</span>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`/distributors/#p-${p.slug}`} class="btn btn-sumac">Request this product</a>
        <a href="/where-to-buy/" class="btn btn-ghost">Ask where to buy</a>
      </div>

      <div class="mt-10 divide-y divide-[#e0d5c1] border-y border-[#e0d5c1]">
        <details class="group py-4" open>
          <summary class="flex justify-between items-center cursor-pointer font-semibold">Serving ideas <span class="group-open:rotate-45 transition-transform text-xl text-cedar">+</span></summary>
          <ul class="mt-3 space-y-1.5 text-stone list-disc pl-5">{p.serving.map((s) => <li>{s}</li>)}</ul>
        </details>
        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer font-semibold">Ingredients &amp; allergens <span class="group-open:rotate-45 transition-transform text-xl text-cedar">+</span></summary>
          <div class="mt-3 text-stone space-y-2 text-[0.95rem]">
            <p><strong class="text-ink">Ingredients:</strong> [Exactly as on the label]</p>
            <p><strong class="text-ink">Contains:</strong> [Allergen statement as on the label]</p>
            <p class="text-xs">Product information is provided for convenience. Ingredients and packaging can change, so always read the label on the product you buy for the most current information, especially if you have food allergies.</p>
          </div>
        </details>
        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer font-semibold">Nutrition facts &amp; storage <span class="group-open:rotate-45 transition-transform text-xl text-cedar">+</span></summary>
          <div class="mt-3 text-stone text-[0.95rem] space-y-2">
            <p>The US Nutrition Facts panel from the label will be shown here.</p>
            <p><strong class="text-ink">Storage:</strong> [e.g. Refrigerate after opening.]</p>
          </div>
        </details>
        <details class="group py-4">
          <summary class="flex justify-between items-center cursor-pointer font-semibold">Trade information <span class="group-open:rotate-45 transition-transform text-xl text-cedar">+</span></summary>
          <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[0.95rem]">
            {trade.map(([k, v]) => (<><dt class="font-medium">{k}</dt><dd class="text-stone">{v}</dd></>))}
          </dl>
        </details>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-sand">
      <div class="wrap py-14 md:py-20">
        <h2 class="text-[2rem] md:text-[2.6rem] mb-8">More {cat.name.toLowerCase()}</h2>
        <div class="grid gap-4 grid-cols-2 lg:grid-cols-4">{related.map((r) => <ProductCard product={r} />)}</div>
      </div>
    </section>
  )}
</Base>
