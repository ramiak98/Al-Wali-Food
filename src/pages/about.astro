---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import OliveMark from '../components/OliveMark.astro';
const values = [
  { title: 'Authenticity', text: 'Traditional recipes that taste the way they do where they come from, not an imitation.' },
  { title: 'Quality', text: 'Carefully selected ingredients and production that meets US food safety requirements.' },
  { title: 'Family', text: 'Food is how families welcome people. We want every jar to feel like an invitation.' },
  { title: 'Partnership', text: 'We work closely with distributors and retailers so our products are always on the shelf.' },
];
const numbers = [
  ['25+', 'products'],
  ['5', 'product families'],
  ['[XX]', 'US states'],
  ['[XX]', 'distribution partners'],
];
---
<Base title="About Al Wali Food | Mediterranean Flavors, American Tables" fullTitle description="Learn the story behind Al Wali Food, a food brand bringing authentic Mediterranean and Middle Eastern pickles, dairy, olive oil, pastes and sweets to the USA.">
  <PageHero photo="olive-grove" eyebrow="About us" title="Our story" subtitle="Mediterranean flavors, shared with America." tall />

  <section class="wrap py-16 md:py-24 grid gap-10 md:grid-cols-[1fr_1.3fr]">
    <div>
      <p class="eyebrow">Who we are</p>
      <h2 class="text-[2.3rem] md:text-[3rem] mt-2">The foods we grew up with, made with the same care</h2>
    </div>
    <div class="text-stone space-y-5 text-[1.05rem] min-w-0">
      <p>Al Wali Food was founded in [YEAR] by [FOUNDER / FAMILY NAME] with a simple idea: the foods we grew up with deserve a place in American kitchens, made with the same care and the same honest ingredients.</p>
      <p>Today we bring a full Mediterranean and Middle Eastern pantry to the United States, sourced from trusted producers in Lebanon and other countries. It runs from crunchy pickled turnips and creamy labneh to golden olive oil, rich pepper paste and sweet halawa. Our products reach shoppers through a network of distributors and stores across [STATES / REGIONS].</p>
    </div>
  </section>

  <section class="grid md:grid-cols-3 gap-1 bg-ink">
    <Photo name="dairy-goats" width={1000} class="w-full h-[240px] md:h-[380px]" />
    <Photo name="olive-grove" width={1000} class="w-full h-[240px] md:h-[380px]" />
    <Photo name="pepper-plant" width={1000} class="w-full h-[240px] md:h-[380px]" />
  </section>

  <section class="bg-sand">
    <div class="wrap py-16 md:py-24 grid gap-10 md:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="eyebrow">Where our flavors come from</p>
        <h2 class="text-[2.3rem] md:text-[3rem] mt-2">Sourced where they taste best</h2>
      </div>
      <div class="text-stone space-y-5 text-[1.05rem] min-w-0">
        <p>Around the Mediterranean and across the Middle East, families have pickled, preserved and pressed the harvest for thousands of years. We look for the producers who still do it that way, wherever they are.</p>
        <p>Our products follow the rhythm of the seasons: vegetables pickled at the peak of the season, milk turned into labneh the traditional way, tomatoes and peppers slow-cooked into deep, rich pastes.</p>
      </div>
    </div>
  </section>

  <section class="wrap py-16 md:py-24">
    <p class="eyebrow">What we stand for</p>
    <h2 class="text-[2.3rem] md:text-[3rem] mt-2 mb-10">Four promises in every jar</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="border-t-2 border-gold pt-5">
          <OliveMark class="w-7 h-7 text-cedar" />
          <h3 class="text-[1.7rem] mt-3 text-cedar">{v.title}</h3>
          <p class="text-stone mt-2 text-[0.98rem]">{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-cedar text-white">
    <div class="wrap py-12 grid grid-cols-2 md:grid-cols-4 gap-8">
      {numbers.map(([n, l]) => (
        <div>
          <p class="font-display text-[3rem] md:text-[3.6rem] font-semibold leading-none tabular-nums">{n}</p>
          <p class="text-white/80 mt-2 text-sm uppercase tracking-[0.14em]">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap py-16 md:py-24 text-center flex flex-col items-center">
    <OliveMark class="w-10 h-10 text-gold" />
    <h2 class="text-[2.4rem] md:text-[3.2rem] mt-4">Bring these flavors home</h2>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/products/" class="btn btn-cedar">Explore our products</a>
      <a href="/distributors/" class="btn btn-sumac">Become a partner</a>
    </div>
  </section>
</Base>
