---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; fullTitle?: boolean }
const { title, description = 'Al Wali Food brings authentic Lebanese pickles, dairy, olive oil, pastes and sweets to the USA. Find a store near you or become a distributor.', fullTitle = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | Al Wali Food`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1F4D3A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&family=Noto+Naskh+Arabic:wght@500&display=swap" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:p-3 focus:rounded">Skip to content</a>
    <div class="bg-ink text-[#f3e7cf] text-[0.8rem]">
      <p class="wrap py-2 text-center">Demo preview. Products, photos and company details are placeholders.</p>
    </div>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-50 pb-[env(safe-area-inset-bottom,0px)]" hidden>
      <div class="wrap pb-4">
        <div class="bg-cream border border-[#d8ccb4] rounded-[6px] shadow-[0_18px_40px_-16px_rgba(43,36,32,.45)] p-5 flex flex-col md:flex-row md:items-center gap-4">
          <p class="text-[0.92rem] flex-1 min-w-0">We use cookies to make this site work and, with your permission, to understand how it is used. See our <a class="link" href="/legal/cookies/">Cookie Policy</a>.</p>
          <div class="flex gap-2 shrink-0 flex-wrap">
            <button type="button" class="btn btn-ghost !min-h-[42px]" data-cookie-choice="reject">Reject non-essential</button>
            <button type="button" class="btn btn-cedar !min-h-[42px]" data-cookie-choice="accept">Accept all</button>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        // Mobile menu
        var menu = document.getElementById('mobile-menu');
        var openBtn = document.querySelector('[data-menu-open]');
        var closeBtn = document.querySelector('[data-menu-close]');
        function setMenu(open) {
          if (!menu) return;
          menu.hidden = !open;
          document.documentElement.style.overflow = open ? 'hidden' : '';
          if (openBtn) openBtn.setAttribute('aria-expanded', String(open));
          if (open && closeBtn) closeBtn.focus();
        }
        if (openBtn) openBtn.addEventListener('click', function () { setMenu(true); });
        if (closeBtn) closeBtn.addEventListener('click', function () { setMenu(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });

        // Photos that could not load fall back to their drawn stand-in
        document.querySelectorAll('img[data-fallback]').forEach(function (img) {
          if (img.complete && img.naturalWidth === 0 && img.src.indexOf(img.dataset.fallback) < 0) img.src = img.dataset.fallback;
        });

        // Demo forms: validate, then show the success message instead of sending
        document.querySelectorAll('form[data-demo-form]').forEach(function (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!form.checkValidity()) { form.reportValidity(); return; }
            var msg = document.createElement('div');
            msg.setAttribute('role', 'status');
            msg.className = 'rounded-[6px] bg-cedar text-white p-5';
            msg.innerHTML = '<p class="font-display text-[1.6rem] font-semibold leading-tight">Thank you!</p><p class="mt-1 text-white/90"></p><p class="mt-3 text-xs text-white/70">Demo only: nothing was sent.</p>';
            msg.querySelector('p.mt-1').textContent = form.dataset.success || 'We received your message.';
            form.replaceWith(msg);
          });
        });

        // Cookie banner (remembered for this browser only)
        var banner = document.getElementById('cookie-banner');
        var stored = null;
        try { stored = localStorage.getItem('awf-cookies'); } catch (e) {}
        if (banner && !stored) banner.hidden = false;
        document.querySelectorAll('[data-cookie-choice]').forEach(function (b) {
          b.addEventListener('click', function () {
            try { localStorage.setItem('awf-cookies', b.dataset.cookieChoice); } catch (e) {}
            banner.hidden = true;
          });
        });
        document.querySelectorAll('[data-cookie-settings]').forEach(function (b) {
          b.addEventListener('click', function () { banner.hidden = false; });
        });
      })();
    </script>
  </body>
</html>
